{
  "name": "fuel-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Fuel Tracker - PWA empacotado com Capacitor (assets locais, sem URL remota)",
  "scripts": {
    "test": "node tests/billing.test.js",
    "build:web": "node scripts/copy-web.js",
